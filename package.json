{
  "name": "shiftcore",
  "version": "1.0.0",
  "description": "ShiftCore — Dashboard theo dõi giờ tăng ca công nhân (HR + T8 + Igarment)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:ui": "node scripts/build-ui.mjs",
    "demo": "DEMO=1 node server.js",
    "lint": "eslint .",
